# Copy this file to .env. Never commit .env or API keys.
# LLM_PROVIDER: mock | gemini | groq | openrouter | ollama
LLM_PROVIDER=mock
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama's OpenAI-compatible local endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
# true = rules + LLM classifier; false = deterministic rules only
USE_LLM_CLASSIFIER=true
# Keep local and free-tier providers responsive. Lower values are faster.
MAX_HISTORY_TURNS=6
LLM_MAX_OUTPUT_TOKENS=180
CLASSIFIER_MAX_OUTPUT_TOKENS=50
LLM_TIMEOUT_SECONDS=30
# Ollama-only performance settings: retain the model in memory and cap context.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=1024
# false = omit conversation text from SQLite logs
STORE_MESSAGES=true

# Optional privacy-safe Gmail admin notification for a crisis route.
# Use a Gmail App Password, never your normal Gmail password. Emails omit chat text.
EMAIL_ALERTS_ENABLED=false
ADMIN_ALERT_EMAIL=
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
EMAIL_ALERT_TIMEOUT_SECONDS=12
