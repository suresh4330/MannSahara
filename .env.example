# Copy this file to .env and edit. Never commit .env to GitHub.
# LLM_PROVIDER: mock | gemini | openai | ollama
LLM_PROVIDER=mock
# Leave LLM_MODEL empty to use the default for the provider (see app/llm.py)
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Only needed for OpenAI-compatible servers other than OpenAI itself
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1
# true = rules + LLM classifier, false = rules only
USE_LLM_CLASSIFIER=true
# false = do not store message text in SQLite (stores risk levels and routes only)
STORE_MESSAGES=true

